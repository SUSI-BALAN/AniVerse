# ============================================================
# ANIVERSE ENVIRONMENT EXAMPLE
# Copy required values into the real runtime .env files.
# NEVER commit real secrets.
# ============================================================

# ============================================================
# SERVER
# ============================================================

PORT=4000

# development | production | test
NODE_ENV=development

# sqlite | postgres
DATABASE_MODE=postgres

# local | supabase
AUTH_MODE=local

# Exact frontend origin only.
# Do NOT include paths.
CLIENT_ORIGIN=http://localhost:5173

# 0 for normal localhost development.
# Enable only when deployed behind a trusted reverse proxy.
TRUST_PROXY=0

BUILD_ID=development

# ============================================================
# ANILIST
# ============================================================

ANILIST_API_URL=https://graphql.anilist.co

ANILIST_TIMEOUT_MS=10000
ANILIST_DETAILS_CACHE_TTL_SECONDS=43200
ANILIST_TRENDING_CACHE_TTL_SECONDS=1200
ANILIST_POPULAR_CACHE_TTL_SECONDS=1800
ANILIST_SEASONAL_CACHE_TTL_SECONDS=10800

# ============================================================
# SQLITE LOCAL MODE
# ============================================================

DATABASE_PATH=./data/aniverse.db

# ============================================================
# POSTGRESQL / SUPABASE DATABASE
# Server only.
# NEVER expose DATABASE_URL in VITE_* variables.
# ============================================================

DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

DATABASE_POOL_MAX=5

# true for hosted Supabase/PostgreSQL
DATABASE_SSL=true
# Used only by PostgreSQL integration tests.
TEST_DATABASE_URL=

# ============================================================
# SUPABASE AUTH
# Project URL must look like:
# https://YOUR_PROJECT_REF.supabase.co
#
# Keep existing variable names if current AniVerse code
# already expects SUPABASE_ANON_KEY.
# The value may be the newer sb_publishable_... key.
# ============================================================

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# ============================================================
# FRONTEND / VITE
# In a monorepo these should normally be placed in the
# frontend's own .env.local file.
# ============================================================

VITE_AUTH_MODE=local

VITE_API_BASE_URL=http://localhost:4000

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# ============================================================
# OPERATIONAL / LIVE TESTS
# ============================================================

SMOKE_API_BASE_URL=http://localhost:4000

# User A
LIVE_TEST_EMAIL=user-a@example.com
LIVE_TEST_PASSWORD=REPLACE_WITH_TEST_ACCOUNT_PASSWORD_A

# User B
LIVE_TEST_EMAIL_B=user-b@example.com
LIVE_TEST_PASSWORD_B=REPLACE_WITH_TEST_ACCOUNT_PASSWORD_B

RUN_LIVE_SUPABASE_TESTS=true


# ============================================================
# PLAYBACK PROVIDERS
#
# Keep disabled until:
# 1. configuration is complete
# 2. current embed documentation is verified
# 3. intended use is permitted
# ============================================================

CINEXTREAM_BASE_URL=https://cinextream.cc/
CINEXTREAM_ENABLED=false
CINEXTREAM_EMBED_PATH=

YENIME_BASE_URL=https://api.yenime.net/
YENIME_ENABLED=false
YENIME_EMBED_PATH=

ZOKOANIME_BASE_URL=https://zokoanime.video/
ZOKOANIME_ENABLED=false
ZOKOANIME_EMBED_PATH=

DEFAULT_PROVIDER=cinextream

# Download the project database CA certificate from Supabase Database Settings ? SSL Configuration.
DATABASE_CA_CERT_PATH=
